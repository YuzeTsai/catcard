[{"id": 1, "name": "尖叫小隊長", "rarity": "R", "image": "assets/cat-1.jpg", "story": "皺著鼻子、露出牙齒，像剛聽到不想聽的消息。", "type": "皮"}, {"id": 2, "name": "瞳孔地震", "rarity": "SR", "image": "assets/cat-2.jpg", "story": "睜著一雙圓眼，像剛聽到全世界最離譜的八卦。", "type": "萌"}, {"id": 3, "name": "夜巡員", "rarity": "N", "image": "assets/cat-3.jpg", "story": "咖啡店的桌上，黑貓悠哉趴著，白貓在花瓶後面守著。", "type": "皮"}, {"id": 4, "name": "夢裡有罐罐", "rarity": "N", "image": "assets/cat-4.jpg", "story": "閉著眼側躺，這一覺睡得很沉。", "type": "萌"}, {"id": 5, "name": "毛球模式", "rarity": "N", "image": "assets/cat-5.jpg", "story": "縮成一顆毛球，尾巴繞著身體收得剛剛好。", "type": "懶"}, {"id": 6, "name": "凝視深淵", "rarity": "R", "image": "assets/cat-6.jpg", "story": "雙眼直直盯著鏡頭，看得你有點心虛。", "type": "懶"}, {"id": 7, "name": "今天也很乖", "rarity": "N", "image": "assets/cat-7.jpg", "story": "耳朵一豎、眼睛一瞪，鏡頭差點貼上牠的臉。", "type": "萌"}, {"id": 8, "name": "沙發總監", "rarity": "R", "image": "assets/cat-8.jpg", "story": "旁邊坐著灰色玩偶，牠一臉淡定，氣場絲毫不輸。", "type": "懶"}, {"id": 9, "name": "躺平練習生", "rarity": "N", "image": "assets/cat-9.jpg", "story": "趴在沙發上歪頭看你，一隻前爪壓著另一隻。", "type": "懶"}, {"id": 10, "name": "真假貓咪", "rarity": "R", "image": "assets/cat-10.jpg", "story": "低頭湊近貓咪布偶，像在認真確認牠是不是真的。", "type": "皮"}, {"id": 11, "name": "鼻尖特寫", "rarity": "N", "image": "assets/cat-11.jpg", "story": "鼻子和下巴填滿畫面，粉紅肉球躲在角落。", "type": "萌"}, {"id": 12, "name": "摸摸充電中", "rarity": "N", "image": "assets/cat-12.jpg", "story": "被摸著頭瞇起眼睛，整隻貓都在充電。", "type": "萌"}, {"id": 13, "name": "鼻鼻大魔王", "rarity": "SSR", "image": "assets/cat-13.jpg", "story": "鼻頭整個湊到鏡頭前，眼睛從兩側探出頭來。", "type": "皮", "ex": {"n": "鼻尖碰碰", "hit": 18, "pierce": true}}, {"id": 14, "name": "電視兒童", "rarity": "R", "image": "assets/cat-14.jpg", "story": "站在電視櫃上，眼睛盯著螢幕裡的足球賽。", "type": "皮"}, {"id": 15, "name": "午睡研究員", "rarity": "N", "image": "assets/cat-15.jpg", "story": "窩進櫃子裡的小墊子，白色手手輕輕交疊。", "type": "懶"}, {"id": 16, "name": "早安，鏟屎官", "rarity": "N", "image": "assets/cat-16.jpg", "story": "窩在墊子上瞇眼看你，好像在說「還不去鏟屎？」", "type": "皮"}, {"id": 17, "name": "小花領的儀式感", "rarity": "SR", "image": "assets/cat-17.jpg", "story": "穿著狐狸圖案的小圍兜，一臉認真地看著鏡頭。", "type": "萌"}, {"id": 18, "name": "秘密接頭", "rarity": "R", "image": "assets/cat-18.jpg", "story": "側著頭靠在藍色玩偶旁，只露出一邊耳朵。", "type": "皮"}, {"id": 19, "name": "今天不想上班", "rarity": "N", "image": "assets/cat-19.jpg", "story": "裹在毯子裡，眼神寫著今天不想上班。", "type": "懶"}, {"id": 20, "name": "無聲抗議", "rarity": "N", "image": "assets/cat-20.jpg", "story": "和上一張一樣的表情，抗議還在繼續。", "type": "皮"}, {"id": 21, "name": "融化在沙發", "rarity": "N", "image": "assets/cat-21.jpg", "story": "整個人攤在黃色床單上，四肢隨便擺。", "type": "懶"}, {"id": 22, "name": "仰望罐罐之神", "rarity": "SR", "image": "assets/cat-22.jpg", "story": "仰頭看向鏡頭，像在朝拜高處的罐罐之神。", "type": "萌"}, {"id": 23, "name": "肉球小劇場", "rarity": "R", "image": "assets/cat-23.jpg", "story": "粉紅肉球大方伸向鏡頭，後面是一張淡定的臉。", "type": "萌"}, {"id": 24, "name": "吐舌犯規", "rarity": "SR", "image": "assets/cat-24.jpg", "story": "舔了一下鼻子，舌尖還來不及收回去。", "type": "萌"}, {"id": 25, "name": "床鋪佔領者", "rarity": "N", "image": "assets/cat-25.jpg", "story": "趴在黃色床單上，一副「這張床是我的」的氣勢。", "type": "皮"}, {"id": 26, "name": "側臉殺手", "rarity": "N", "image": "assets/cat-26.jpg", "story": "把臉側過去，給你看最帥的那一面。", "type": "皮"}, {"id": 27, "name": "逗貓棒獵人", "rarity": "R", "image": "assets/cat-27.jpg", "story": "拿棉花棒當逗貓棒，牠還是看得很認真。", "type": "皮"}, {"id": 28, "name": "喵之覺醒", "rarity": "SSR", "image": "assets/cat-28.jpg", "story": "張大嘴、睜圓眼，像剛發現了新大陸。", "type": "皮", "ex": {"n": "喵之覺醒", "hit": 17, "heal": 5}}, {"id": 29, "name": "瞌睡感染者", "rarity": "N", "image": "assets/cat-29.jpg", "story": "半睜著眼，快要被睡意打敗。", "type": "懶"}, {"id": 30, "name": "貼臉警告", "rarity": "SR", "image": "assets/cat-30.jpg", "story": "鼻子越靠越近，背景是一團軟軟的毯子。", "type": "皮"}, {"id": 31, "name": "再靠近一點", "rarity": "N", "image": "assets/cat-31.jpg", "story": "再靠近一點，鼻子就要戳到鏡頭了。", "type": "皮"}, {"id": 32, "name": "圓眼結界", "rarity": "N", "image": "assets/cat-32.jpg", "story": "圓圓的眼睛盯著你，像張開了一道結界。", "type": "萌"}, {"id": 33, "name": "無辜是武器", "rarity": "N", "image": "assets/cat-33.jpg", "story": "歪著頭、睜大眼，一臉無辜。", "type": "萌"}, {"id": 34, "name": "宇宙小鬍子", "rarity": "R", "image": "assets/cat-34.jpg", "story": "瞇著眼靠在木框邊，鬍子看起來特別有型。", "type": "懶"}, {"id": 35, "name": "星河之鼻", "rarity": "SEC", "image": "assets/cat-13.jpg", "story": "鼻子貼著鏡頭，連鼻紋都看得一清二楚。", "type": "萌", "ex": {"n": "星河之鼻", "hit": 18, "pierce": true, "weak": true}}, {"id": 36, "name": "喵皇・完全覺醒", "rarity": "SEC", "image": "assets/cat-28.jpg", "story": "張大嘴露出尖牙，這是牠最有氣勢的一刻。", "type": "皮", "ex": {"n": "喵皇降臨", "hit": 21}}, {"id": 37, "name": "瞳孔裡的平行宇宙", "rarity": "SEC", "image": "assets/cat-2.jpg", "story": "睜著一雙大圓眼，像剛看到不可思議的東西。", "type": "萌", "ex": {"n": "平行宇宙", "hit": 15, "heal": 5, "pierce": true}}, {"id": 38, "name": "黑白小紳士", "rarity": "SR", "image": "assets/cat-38.jpg", "story": "被一雙手穩穩抱著，圓圓的眼睛有點緊張。", "type": "萌"}, {"id": 39, "name": "圓臉巡邏員", "rarity": "R", "image": "assets/cat-39.jpg", "story": "坐在玻璃門邊，抬頭盯著你看。", "type": "萌"}, {"id": 40, "name": "門口的守護者", "rarity": "N", "image": "assets/cat-40.jpg", "story": "乖乖坐在門口，像在等你回家。", "type": "皮"}, {"id": 41, "name": "球球獵人", "rarity": "R", "image": "assets/cat-41.jpg", "story": "抱著黃色小球不放，橘色那顆被晾在一邊。", "series": 2, "type": "皮"}, {"id": 42, "name": "初次見面", "rarity": "N", "image": "assets/cat-42.jpg", "story": "窩在手臂上，用大眼睛盯著你看。", "series": 2, "type": "萌"}, {"id": 43, "name": "粉紅肉球", "rarity": "SR", "image": "assets/cat-43.jpg", "story": "最軟的粉紅肉球，看再多次也不膩。", "series": 2, "type": "萌"}, {"id": 44, "name": "鼻頭特寫", "rarity": "SR", "image": "assets/cat-44.jpg", "story": "鼻子貼到鏡頭，鬍鬚根根分明。", "series": 2, "type": "皮"}, {"id": 45, "name": "瞳孔宇宙", "rarity": "SR", "image": "assets/cat-45.jpg", "story": "眼睛裡倒映著整個房間。", "series": 2, "type": "懶"}, {"id": 46, "name": "窗邊的夜行者", "rarity": "SR", "image": "assets/cat-46.jpg", "story": "靠在窗邊，嘴巴微張像在說話，外面天色漸暗。", "series": 2, "type": "皮"}, {"id": 47, "name": "兔帽小天使", "rarity": "SSR", "image": "assets/cat-47.jpg", "story": "戴著白色兔耳帽，窩在毯子堆裡一臉淡定。", "series": 2, "type": "萌", "ex": {"n": "兔兔庇護", "guard": true, "heal": 6, "weak": true}}, {"id": 48, "name": "肚肚警報", "rarity": "R", "image": "assets/cat-48.jpg", "story": "翻出肚子被摸，眼睛瞪得圓圓的。", "series": 2, "type": "皮"}, {"id": 49, "name": "鏡頭偷襲", "rarity": "N", "image": "assets/cat-49.jpg", "story": "鼻子先到，其他部位隨後抵達。", "series": 2, "type": "皮"}, {"id": 50, "name": "橘座駕到", "rarity": "R", "image": "assets/cat-50.jpg", "story": "橘貓坐在毛毛床上，表情像在審核你的報告。", "series": 2, "type": "懶"}, {"id": 51, "name": "枕邊貓", "rarity": "N", "image": "assets/cat-51.jpg", "story": "臉埋在枕頭邊，睡意正濃。", "series": 2, "type": "懶"}, {"id": 52, "name": "橘座沉思", "rarity": "N", "image": "assets/cat-52.jpg", "story": "同一張毛毛床，換成低頭沉思的角度。", "series": 2, "type": "懶"}, {"id": 53, "name": "白色雲朵", "rarity": "SR", "image": "assets/cat-53.jpg", "story": "白毛團睡在牆邊，像一朵軟綿綿的雲。", "series": 2, "type": "懶"}, {"id": 54, "name": "仰角大賞", "rarity": "R", "image": "assets/cat-54.jpg", "story": "從下往上看，眼睛瞪得圓圓的。", "series": 2, "type": "萌"}, {"id": 55, "name": "躲貓貓", "rarity": "N", "image": "assets/cat-55.jpg", "story": "鑽進毯子底下，只露出一隻白色小腳。", "series": 2, "type": "皮"}, {"id": 56, "name": "歪頭殺", "rarity": "R", "image": "assets/cat-56.jpg", "story": "側躺著歪著頭，嘴巴微張像在說話。", "series": 2, "type": "萌"}, {"id": 57, "name": "長毛橘仔", "rarity": "SR", "image": "assets/cat-57.jpg", "story": "長毛橘貓貼著牆邊躺在木地板上，尾巴蓬蓬的。", "series": 2, "type": "懶"}, {"id": 58, "name": "模糊的鼻尖", "rarity": "N", "image": "assets/cat-58.jpg", "story": "鼻子太近，整個畫面都糊成一團。", "series": 2, "type": "萌"}, {"id": 59, "name": "圓滾滾麵包", "rarity": "SSR", "image": "assets/cat-59.jpg", "story": "團成一顆麵包坐在椅子上，瞇眼仰頭，一臉得意。", "series": 2, "type": "懶", "ex": {"n": "麵包護盾", "guard": true, "heal": 8}}, {"id": 60, "name": "毯子偵探", "rarity": "N", "image": "assets/cat-60.jpg", "story": "從毯子縫裡偷看，眼睛只露出一半。", "series": 2, "type": "皮"}, {"id": 61, "name": "銀白夢鄉", "rarity": "SR", "image": "assets/cat-61.jpg", "story": "銀白色的貓趴在椅子扶手上，睡得很沉。", "series": 2, "type": "懶"}, {"id": 62, "name": "閉眼的鼻鼻", "rarity": "N", "image": "assets/cat-62.jpg", "story": "閉著眼睛，鼻頭粉粉的，睡臉近在眼前。", "series": 2, "type": "懶"}, {"id": 63, "name": "彈跳床店長", "rarity": "SR", "image": "assets/cat-63.jpg", "story": "坐在圓形彈跳床的粉紅小墊子上，低頭看著腳邊。", "series": 2, "type": "皮"}, {"id": 64, "name": "路邊小訪客", "rarity": "N", "image": "assets/cat-64.jpg", "story": "仰著頭看著你，尾巴翹得高高的。", "series": 2, "type": "萌"}, {"id": 65, "name": "玩偶護衛隊", "rarity": "R", "image": "assets/cat-65.jpg", "story": "被一排玩偶圍著，在枕頭邊睡得香甜。", "series": 2, "type": "懶"}, {"id": 66, "name": "摀臉大師", "rarity": "R", "image": "assets/cat-66.jpg", "story": "用前爪遮住臉，只露出粉紅肉球。", "series": 2, "type": "萌"}, {"id": 67, "name": "鼻頭領域", "rarity": "N", "image": "assets/cat-67.jpg", "story": "貼近鏡頭的鼻頭，背景有隻小熊圖案的靠枕。", "series": 3, "type": "萌"}, {"id": 68, "name": "歪頭審問", "rarity": "R", "image": "assets/cat-68.jpg", "story": "靠在毛巾上，眼神像要審問你剛剛去哪了。", "series": 3, "type": "萌"}, {"id": 69, "name": "粉紅點點巡邏", "rarity": "N", "image": "assets/cat-69.jpg", "story": "走過粉紅色點點毯，回頭看了一眼。", "series": 3, "type": "皮"}, {"id": 70, "name": "窗邊警報", "rarity": "SR", "image": "assets/cat-70.jpg", "story": "看到窗外有動靜，嘴巴微張、一隻手舉在半空。", "series": 3, "type": "皮"}, {"id": 71, "name": "毛毯上的大眼", "rarity": "R", "image": "assets/cat-71.jpg", "story": "圓圓的綠眼睛，窩在點點毛毯上。", "series": 3, "type": "萌"}, {"id": 72, "name": "玩偶旁邊的主人", "rarity": "N", "image": "assets/cat-72.jpg", "story": "靠在大玩偶身邊，一臉嚴肅。", "series": 3, "type": "懶"}, {"id": 73, "name": "小腳印毯子", "rarity": "R", "image": "assets/cat-73.jpg", "story": "窩在小腳印圖案的毯子上，表情很放鬆。", "series": 3, "type": "懶"}, {"id": 74, "name": "近距離鼻鼻", "rarity": "N", "image": "assets/cat-74.jpg", "story": "大大的鼻子占滿畫面，眼睛瞪得圓圓的。", "series": 3, "type": "萌"}, {"id": 75, "name": "鬍鬚特寫", "rarity": "R", "image": "assets/cat-75.jpg", "story": "趴在墊子上，鬍鬚根根分明，眼神很專注。", "series": 3, "type": "懶"}, {"id": 76, "name": "乖乖坐好", "rarity": "SR", "image": "assets/cat-76.jpg", "story": "坐在床邊，綠眼睛瞪得圓圓的，一副很乖的樣子。", "series": 3, "type": "萌"}, {"id": 77, "name": "枕頭上的嚴肅", "rarity": "N", "image": "assets/cat-77.jpg", "story": "窩在枕頭上，眉頭微皺。", "series": 3, "type": "懶"}, {"id": 78, "name": "高處的觀察員", "rarity": "R", "image": "assets/cat-78.jpg", "story": "趴在木板邊緣，從高處低頭看你。", "series": 3, "type": "皮"}, {"id": 79, "name": "伸展運動", "rarity": "SR", "image": "assets/cat-79.jpg", "story": "伸展完身體，大步朝鏡頭走來。", "series": 3, "type": "皮"}, {"id": 80, "name": "只露出頭", "rarity": "N", "image": "assets/cat-80.jpg", "story": "只露出一顆頭，像在偷看這個世界。", "series": 3, "type": "皮"}, {"id": 81, "name": "紙箱的主人", "rarity": "R", "image": "assets/cat-81.jpg", "story": "擠進紙箱，嘴巴微張像在說話。", "series": 3, "type": "皮"}, {"id": 82, "name": "吐司貓", "rarity": "SSR", "image": "assets/cat-82.jpg", "story": "戴著吐司麵包項圈，表情一本正經。", "series": 3, "type": "萌", "ex": {"n": "吐司回彈", "guard": true, "hit": 12}}, {"id": 83, "name": "瞇眼享受", "rarity": "N", "image": "assets/cat-83.jpg", "story": "靠在貓抓板上，瞇著眼睛很享受。", "series": 3, "type": "萌"}, {"id": 84, "name": "空中接球", "rarity": "SSR", "image": "assets/cat-84.jpg", "story": "站起來伸手撲向逗貓棒，整個人拉得好長。", "series": 3, "type": "皮", "ex": {"n": "空中撲擊", "hit": 20}}, {"id": 85, "name": "紅蘿蔔守護者", "rarity": "SR", "image": "assets/cat-85.jpg", "story": "躺在地板上，抱著紅蘿蔔玩具不放。", "series": 3, "type": "懶"}, {"id": 86, "name": "大打哈欠", "rarity": "R", "image": "assets/cat-86.jpg", "story": "趴在白色地墊上，嘴巴張到最大。", "series": 3, "type": "懶"}, {"id": 87, "name": "綠色變身", "rarity": "SEC", "image": "assets/cat-87.jpg", "story": "戴上綠色青蛙帽，一臉無奈。", "series": 3, "type": "萌", "ex": {"n": "青蛙變身", "guard": true, "weak": true, "hit": 13}}, {"id": 88, "name": "半睜的眼", "rarity": "N", "image": "assets/cat-88.jpg", "story": "被摸著下巴，眼睛半睜著。", "series": 3, "type": "懶"}, {"id": 89, "name": "睡成一個圈", "rarity": "SR", "image": "assets/cat-89.jpg", "story": "四肢蜷在一起，睡成一個圈。", "series": 3, "type": "懶"}, {"id": 90, "name": "背影風景", "rarity": "N", "image": "assets/cat-90.jpg", "story": "走向飯碗，只留下尾巴和背影。", "series": 3, "type": "皮"}, {"id": 91, "name": "方塊洞洞", "rarity": "SR", "image": "assets/cat-91.jpg", "story": "倒掛在貓屋洞口，嘴巴張開像在笑。", "series": 3, "type": "皮"}, {"id": 92, "name": "伸懶腰", "rarity": "R", "image": "assets/cat-92.jpg", "story": "趴著睡覺，手臂向前伸得長長的。", "series": 3, "type": "懶"}, {"id": 93, "name": "地板上的訪客", "rarity": "N", "image": "assets/cat-93.jpg", "story": "趴在地上，睜大眼睛看著鏡頭。", "series": 3, "type": "萌"}, {"id": 94, "name": "毯子上的鼻鼻", "rarity": "N", "image": "assets/cat-94.jpg", "story": "鼻頭粉粉的，臉貼在點點毯子上。", "series": 3, "type": "萌"}]